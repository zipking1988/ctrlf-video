# Templates only. The application does not automatically load .env.
# Fixture mode sends no model requests.
CTRLF_VIDEO_MODE=fixture
CTRLF_VIDEO_COARSE_FRAMES=12
CTRLF_VIDEO_CANDIDATE_K=10
CTRLF_VIDEO_RERANK_K=5
CTRLF_VIDEO_TTL_HOURS=24

# Private storage and trusted Gemini runtime; configuration installs no approval.
# CTRLF_DATA_DIR=/absolute/private/path/ctrlf-video-data
# CTRLF_RUNTIME_FILE=/absolute/private/path/runtime.json
# CTRLF_PUBLIC_ORIGIN=https://your-reviewed-deployment.example
# Use docs/runtime.example.json as blocked preparation only.
# Set GEMINI_API_KEY privately in the backend environment, never in browser code.
# Real calls, approvals and cloud provisioning need separate numeric authorization.
